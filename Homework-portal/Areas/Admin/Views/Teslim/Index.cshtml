@model IEnumerable<Homework_portal.Models.Teslim>

@{
    ViewData["Title"] = "Ödev Teslimleri";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="text-primary">Teslim Edilen Ödevler</h2>
            <hr />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            Sisteme yüklenmiş bir teslim bulunmamaktadır.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped table-hover shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Ders</th>
                    <th>Ödev</th>
                    <th>Öğrenci</th>
                    <th>Teslim Tarihi</th>
                    <th>Not</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teslim in Model)
                {
                    <tr>
                        <td>@teslim.Odev.Ders.Ad</td>
                        <td>@teslim.Odev.Baslik</td>
                        <td>@teslim.Ogrenci.Ad @teslim.Ogrenci.Soyad</td>
                        <td>@teslim.TeslimTarihi.ToString("dd MMMM yyyy, HH:mm")</td>
                        <td>
                            @if (teslim.Not.HasValue)
                            {
                                <span class="badge bg-success fs-6">@teslim.Not.Value</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark fs-6">Not Girilmedi</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Detay" asp-route-id="@teslim.Id" class="btn btn-info btn-sm">
                                <i class="bi bi-search"></i> İncele / Not Ver
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>