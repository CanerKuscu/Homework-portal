<!-- Admin Layout (notifications bottom right) -->
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Homework Portal Admin" />
    <title>@ViewData["Title"] - Yönetim</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sb-admin/css/styles.css" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        #live-notifications { position: fixed; bottom: 20px; right: 20px; z-index: 1080; width: 360px; }
        #live-notifications .alert { 
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15); 
            margin-top: .5rem;
            transition: opacity 0.3s ease-out;
        }
        #live-notifications .alert.fade-out {
            opacity: 0;
        }
        /* Gizlemede geçişte kaymayı önlemek için */
        #server-alerts[hidden] { display: none !important; }
    </style>
</head>
<body class="sb-nav-fixed">

    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <button class="btn btn-link btn-sm order-0 ms-2 me-2" id="sidebarToggle" aria-label="Menüyü Aç/Kapat">
            <i class="fas fa-bars"></i>
        </button>
        <a class="navbar-brand pe-2" asp-area="Admin" asp-controller="Home" asp-action="Index">Yönetim</a>
        <ul class="navbar-nav ms-auto me-3 me-lg-4">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle d-flex align-items-center" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-user fa-fw"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                    <li>
                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                            <i class="fas fa-cog me-2"></i>Hesap Ayarları
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <form class="d-inline" asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item">
                                <i class="fas fa-sign-out-alt me-2"></i>Çıkış Yap
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="live-notifications"></div>

    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav flex-column">
                        <div class="sb-sidenav-menu-heading">GENEL</div>
                        <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                            Gösterge Paneli
                        </a>
                        <div class="sb-sidenav-menu-heading">YÖNETİM</div>
                        <a class="nav-link" asp-area="Admin" asp-controller="Course" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-book-open"></i></div>Dersler
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="Assignment" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-tasks"></i></div>Ödevler
                        </a>
                        <a class="nav-link d-flex justify-content-between align-items-center" asp-area="Admin" asp-controller="Submission" asp-action="Index">
                            <span>
                                <div class="sb-nav-link-icon d-inline"><i class="bi bi-box-arrow-in-down"></i></div>Teslimler
                            </span>
                            <span id="badge-submissions" class="badge bg-danger rounded-pill" style="display:none;"></span>
                        </a>
                        <a class="nav-link d-flex justify-content-between align-items-center" asp-area="Admin" asp-controller="TeacherApproval" asp-action="Pending">
                            <span>
                                <div class="sb-nav-link-icon d-inline"><i class="fas fa-user-check"></i></div>Öğretmen Onayı
                            </span>
                            <span id="badge-teachers" class="badge bg-warning text-dark rounded-pill" style="display:none;"></span>
                        </a>
                        <a class="nav-link" asp-area="Admin" asp-controller="Account" asp-action="Users">
                            <div class="sb-nav-link-icon"><i class="fas fa-users"></i></div>Kullanıcılar
                        </a>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Olarak oturum açıldı:</div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        @User.Identity.Name
                    }
                    else
                    {
                        @:Misafir
                    }
                </div>
            </nav>
        </div>

        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    <div id="server-alerts">
                        @if (TempData["admin_success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                                @TempData["admin_success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                            </div>
                        }
                        @if (TempData["admin_error"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                                @TempData["admin_error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                            </div>
                        }
                    </div>

                    @RenderBody()
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">&copy; 2025 - Ödev Portalı</div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sb-admin/js/scripts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        // Auto close alerts
        setTimeout(() => {
            document.querySelectorAll('#server-alerts .alert').forEach(el => {
                try { new bootstrap.Alert(el).close(); } catch { }
            });
        }, 4000);

        const STORAGE_KEY = 'portal_live_notifications';
        const DISPLAY_WINDOW_MS = 15000;

        // Son eklenen aynı bildirim tekrar gösterilmesin
        let lastNotificationSignature = '';
        let hasLiveNotification = false;

        function hideServerAlerts() {
            const host = document.getElementById('server-alerts');
            if (host && !host.hasAttribute('hidden')) {
                host.setAttribute('hidden', '');
            }
        }

        function loadStoredNotifications() {
            try {
                const raw = sessionStorage.getItem(STORAGE_KEY);
                if (!raw) return;
                const now = Date.now();
                const arr = (JSON.parse(raw) || []).filter(n => now - (n.ts || 0) < DISPLAY_WINDOW_MS);
                if (arr.length > 0) {
                    hideServerAlerts();
                    hasLiveNotification = true;
                }
                arr.forEach(n => addLiveNotification(n.title, n.message));
                sessionStorage.removeItem(STORAGE_KEY);
            } catch { }
        }
        function storeNotification(title, message) {
            try {
                const arr = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
                arr.push({ title, message, ts: Date.now() });
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
            } catch { }
        }

        function addLiveNotification(title, message, autoClose = true) {
            const host = document.getElementById('live-notifications');
            if (!host) return;
            const signature = title + '|' + message;
            if (signature === lastNotificationSignature) {
                return; // duplicate
            }
            lastNotificationSignature = signature;

            // Canlı bildirim varsa üstteki sunucu alertlerini gizle
            hideServerAlerts();
            hasLiveNotification = true;

            const wrapper = document.createElement('div');
            wrapper.className = 'alert alert-info alert-dismissible fade show';
            wrapper.role = 'alert';
            wrapper.innerHTML = `<strong>${title}:</strong> ${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>`;
            host.appendChild(wrapper);
            
            // Her zaman otomatik kapat (5 saniye sonra)
            setTimeout(function() {
                wrapper.classList.add('fade-out');
                setTimeout(function() {
                    wrapper.remove();
                }, 300);
            }, 5000);
        }

        // Badge sayılarını güncelle
        function updateBadgeCounts() {
            fetch('/Admin/Badge/GetCounts')
                .then(r => r.json())
                .then(data => {
                    const subBadge = document.getElementById('badge-submissions');
                    const teacherBadge = document.getElementById('badge-teachers');
                    
                    if (subBadge) {
                        if (data.pendingSubmissions > 0) {
                            subBadge.textContent = data.pendingSubmissions;
                            subBadge.style.display = '';
                        } else {
                            subBadge.style.display = 'none';
                        }
                    }
                    
                    if (teacherBadge) {
                        if (data.pendingTeachers > 0) {
                            teacherBadge.textContent = data.pendingTeachers;
                            teacherBadge.style.display = '';
                        } else {
                            teacherBadge.style.display = 'none';
                        }
                    }
                })
                .catch(err => console.error('Badge update error:', err));
        }

        // Sayfa yüklendiğinde ve her 30 saniyede badge'leri güncelle
        updateBadgeCounts();
        setInterval(updateBadgeCounts, 30000);

        loadStoredNotifications();

        (function initSignalR(){
            if (window.signalRInitialized) return;
            window.signalRInitialized = true;
            try {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/notificationHub')
                    .withAutomaticReconnect()
                    .build();

                connection.on('ReceiveNotification', (title, message) => {
                    storeNotification(title, message);
                    addLiveNotification(title, message);
                    // Bildirim geldiğinde badge'leri hemen güncelle
                    updateBadgeCounts();
                });

                connection.start().catch(err => console.error('SignalR error:', err));
            } catch(e) {
                console.error('SignalR init failed:', e);
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>