@model Homework_portal.Models.ViewModels.DersVM
@{
    ViewData["Title"] = Model.Ders.Id == 0 ? "Yeni Ders Ekle" : "Dersi Düzenle";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">@ViewData["Title"]</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Ders" asp-action="Index">Dersler</a></li>
        <li class="breadcrumb-item active">@ViewData["Title"]</li>
    </ol>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Ders Bilgileri</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="Upsert">
                        <input type="hidden" asp-for="Ders.Id" />

                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="Ders.Ad" class="form-label"></label>
                            <input asp-for="Ders.Ad" class="form-control" />
                            <span asp-validation-for="Ders.Ad" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Ders.Aciklama" class="form-label"></label>
                            <textarea asp-for="Ders.Aciklama" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Ders.Aciklama" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Ders.OgretmenId" class="form-label">Öğretmen</label>
                            <select asp-for="Ders.OgretmenId" asp-items="Model.OgretmenListesi" class="form-select">
                                <option value="">-- Öğretmen Seçin --</option>
                            </select>
                            <span asp-validation-for="Ders.OgretmenId" class="text-danger"></span>
                        </div>

                        <hr />
                        @if (Model.Ders.Id == 0)
                        {
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-plus me-1"></i> Oluştur
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i> Güncelle
                            </button>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i> Listeye Geri Dön
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}