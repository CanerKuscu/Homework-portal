@model IEnumerable<Homework_portal.Models.Course>
@{
    ViewData["Title"] = "Ders Yönetimi";
}

<div id="alert-placeholder"></div>

<div class="container-fluid px-4">
    <h1 class="mt-4">Ders Yönetimi</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Gösterge Paneli</a></li>
        <li class="breadcrumb-item active">Dersler</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-book-open me-1"></i>
            Ders Listesi
            <a asp-action="Upsert" class="btn btn-primary btn-sm float-end">
                <i class="fas fa-plus me-1"></i> Ders Ekle
            </a>
        </div>
        <div class="card-body">
            <table id="coursesTable" class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Adý</th>
                        <th>Açýklama</th>
                        <th>Öðretmen</th>
                        <th style="width: 150px;">Ýþlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr id="course-@course.Id">
                            <td>@course.Name</td>
                            <td>@course.Description</td>
                            <td>@course.Teacher.FirstName @course.Teacher.LastName</td>
                            <td>
                                <a asp-action="Upsert" asp-route-id="@course.Id" class="btn btn-warning btn-sm" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm btn-delete"
                                        data-id="@course.Id"
                                        data-name="@course.Name"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Dersi Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <strong><span id="courseNameText"></span></strong> dersini silmek istediðinize emin misiniz?
                <br />
                <small class="text-danger">Bu iþlem geri alýnamaz!</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ýptal</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">Evet, Sil</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            let courseIdToDelete;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            $('.btn-delete').on('click', function () {
                courseIdToDelete = $(this).data('id');
                $('#courseNameText').text($(this).data('name'));
            });

            $('#confirmDeleteButton').on('click', function () {
                $.ajax({
                    url: '/Admin/Course/DeleteById',
                    type: 'DELETE',
                    data: { id: courseIdToDelete },
                    success: function (data) {
                        deleteModal.hide();
                        if (data.success) {
                            $('#course-' + courseIdToDelete).remove();
                            showAlert('success', data.message);
                        } else {
                            showAlert('danger', data.message);
                        }
                    },
                    error: function () {
                        deleteModal.hide();
                        showAlert('danger', 'Sunucu hatasý. Lütfen tekrar deneyin.');
                    }
                });
            });

            function showAlert(type, message) {
                const placeholder = $('#alert-placeholder');
                const wrapper = $('<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">'
                    + message +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button></div>');
                placeholder.append(wrapper);
                setTimeout(() => wrapper.alert('close'), 6000);
            }
        });
    </script>
}
