
@model Homework_portal.Models.ViewModels.OdevVM

@{
    // Formun başlığını, modelin ID'sine göre dinamik olarak ayarlıyoruz
    var title = Model.Odev.Id != 0 ? "Ödevi Güncelle" : "Yeni Ödev Oluştur";
    ViewData["Title"] = title;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">@title</h3>
                </div>
                <div class="card-body">

                    <form method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <input asp-for="Odev.Id" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Odev.DersId" class="form-label"></label>
                            <select asp-for="Odev.DersId"
                                    asp-items="@Model.DersListesi"
                                    class="form-select">
                                <option disabled selected value="0">-- Bir Ders Seçin --</option>
                            </select>
                            <span asp-validation-for="Odev.DersId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Odev.Baslik" class="form-label"></label>
                            <input asp-for="Odev.Baslik" class="form-control" />
                            <span asp-validation-for="Odev.Baslik" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Odev.Aciklama" class="form-label"></label>
                            <textarea asp-for="Odev.Aciklama" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Odev.Aciklama" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Odev.TeslimTarihi" class="form-label"></label>
                            <input asp-for="Odev.TeslimTarihi"
                                   type="datetime-local"
                                   class="form-control"
                                   value="@Model.Odev.TeslimTarihi.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="Odev.TeslimTarihi" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            @if (Model.Odev.Id != 0)
                            {
                                // Güncelleme modu
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-check-lg"></i> Güncelle
                                </button>
                            }
                            else
                            {
                                // Yeni Kayıt modu
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg"></i> Oluştur
                                </button>
                            }

                            <a asp-controller="Odev" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-lg"></i> Listeye Geri Dön
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        // Formdaki validasyon (doğrulama) scriptlerini yükler
        <partial name="_ValidationScriptsPartial" />
    }
}