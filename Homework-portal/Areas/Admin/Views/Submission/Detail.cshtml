@model Homework_portal.Models.Submission

@{
    ViewData["Title"] = "Teslim Detayý";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">Teslim Detayý ve Not Verme</h3>
                </div>

                <form method="post" asp-action="Detail">

                    <input asp-for="Id" type="hidden" />

                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h5 class="text-primary">Teslim</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <strong>Öðrenci:</strong>
                                        @Model.Student.Ad @Model.Student.Soyad
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Öðrenci No:</strong>
                                        @(string.IsNullOrWhiteSpace(Model.Student.OgrenciNo) ? "-" : Model.Student.OgrenciNo)
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Ders:</strong>
                                        @Model.Assignment.Course.Name
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Ödev:</strong>
                                        @Model.Assignment.Title
                                    </li>
                                    <li class="list-group-item">
                                        <strong>Teslim Zamaný:</strong>
                                        @Model.SubmittedAt.ToString("dd MMMM yyyy, HH:mm")
                                    </li>
                                </ul>

                                <h5 class="text-primary mt-4">Dosyalar</h5>
                                @if (string.IsNullOrEmpty(Model.FilePath))
                                {
                                    <div class="alert alert-danger">Yüklenen dosya yok.</div>
                                }
                                else
                                {
                                    var paths = Model.FilePaths;
                                    var names = Model.OriginalFileNames;

                                    <div class="list-group">
                                        @for (int i = 0; i < paths.Length; i++)
                                        {
                                            var path = paths[i];
                                            var original = i < names.Length ? names[i] : "Dosya " + (i + 1);
                                            // Use only the file name portion and normalize extension
                                            var fileNameOnly = System.IO.Path.GetFileName(original ?? string.Empty) ?? string.Empty;
                                            var baseName = System.IO.Path.GetFileNameWithoutExtension(fileNameOnly) ?? string.Empty;
                                            var ext = System.IO.Path.GetExtension(fileNameOnly)?.ToLowerInvariant() ?? string.Empty;
                                            var displayName = (baseName + ext).Trim();
                                            var shortName = displayName.Length > 48 ? displayName.Substring(0, 45) + "..." : displayName;
                                            // sanitize download attribute
                                            var downloadName = displayName.Replace('"', '_').Replace('\'', '_');

                                            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                                                <div class="me-2" style="min-width:0;">
                                                    <span class="text-truncate d-inline-block" style="max-width:420px;" title="@displayName">
                                                        <i class="bi bi-file-earmark me-1"></i>@shortName
                                                    </span>
                                                </div>
                                                <div class="btn-group btn-group-sm mt-2 mt-sm-0" role="group">
                                                    <a href="@path" class="btn btn-success" download="@downloadName" title="Ýndir">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                    <a href="@path" target="_blank" rel="noopener" class="btn btn-outline-secondary" title="Görüntüle">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="col-md-6">
                                <h5 class="text-primary">Not</h5>
                                <p class="text-muted">0 ile 100 arasýnda bir not giriniz.</p>

                                <div class="mb-3">
                                    <label asp-for="Grade" class="form-label">Not</label>
                                    <input asp-for="Grade" type="number" class="form-control form-control-lg" min="0" max="100" placeholder="Örn. 85" />
                                    <span asp-validation-for="Grade" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer text-end">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Kaydet
                        </button>
                        <a asp-controller="Submission" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg"></i> Listeye Dön
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
