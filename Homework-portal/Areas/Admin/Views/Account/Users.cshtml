@using Homework_portal.Utility
@model IEnumerable<Homework_portal.Models.ViewModels.UserRoleVM>
@{
    ViewData["Title"] = "Kullanýcýlar";
    var ogrenciler = Model.Where(m => string.Equals(m.CurrentRole, AppRoles.Role_Ogrenci, StringComparison.OrdinalIgnoreCase)).ToList();
    var ogretmenler = Model.Where(m => string.Equals(m.CurrentRole, AppRoles.Role_Ogretmen, StringComparison.OrdinalIgnoreCase)).ToList();
    var digerleri = Model.Where(m => m.CurrentRole != AppRoles.Role_Ogrenci && m.CurrentRole != AppRoles.Role_Ogretmen).ToList();
}
<div class="container-fluid px-4">
    <h1 class="mt-4">Kullanýcýlar</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Anasayfa</a></li>
        <li class="breadcrumb-item active">Kullanýcýlar</li>
    </ol>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-users me-1"></i> Öðrenciler</span>
            <a class="btn btn-sm btn-success" asp-area="Admin" asp-controller="Account" asp-action="Register">
                <i class="fas fa-user-plus"></i> Yeni Kullanýcý
            </a>
        </div>
        <div class="card-body">
            @Html.Partial("_UsersTable", ogrenciler)
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="fas fa-chalkboard-teacher me-1"></i> Öðretmenler</span>
            <a class="btn btn-sm btn-success" asp-area="Admin" asp-controller="Account" asp-action="Register">
                <i class="fas fa-user-plus"></i> Yeni Kullanýcý
            </a>
        </div>
        <div class="card-body">
            @Html.Partial("_UsersTable", ogretmenler)
        </div>
    </div>

    @if (digerleri.Any())
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fas fa-user-shield me-1"></i> Diðerleri</span>
                <a class="btn btn-sm btn-success" asp-area="Admin" asp-controller="Account" asp-action="Register">
                    <i class="fas fa-user-plus"></i> Yeni Kullanýcý
                </a>
            </div>
            <div class="card-body">
                @Html.Partial("_UsersTable", digerleri)
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
