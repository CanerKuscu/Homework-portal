@using Homework_portal.Models.ViewModels
@model LoginVM
@{
    Layout = null; // Admin şablonunu kullanma!
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ödev Portalı</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        html, body { height: 100%; }
        body { display: flex; align-items: center; padding-top: 40px; padding-bottom: 40px; background-color: #f5f5f5; }
        .form-signin { width: 100%; max-width: 480px; padding: 15px; margin: auto; }
    </style>
</head>
<body class="text-center">
<main class="form-signin">
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success text-start">@TempData["success"]</div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger text-start">@TempData["error"]</div>
    }
    @if (TempData["info"] != null)
    {
        <div class="alert alert-info text-start">@TempData["info"]</div>
    }

    <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
        <h1 class="h4 mb-3 fw-normal">Kullanıcı Girişi</h1>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="form-floating mb-3">
            <input asp-for="Identifier" class="form-control" id="floatingId" placeholder="E-posta veya Öğrenci No">
            <label asp-for="Identifier">E-posta veya Öğrenci No</label>
            <span asp-validation-for="Identifier" class="text-danger"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Password" type="password" class="form-control" id="floatingPassword" placeholder="Şifre">
            <label asp-for="Password">Şifre</label>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="checkbox mb-3">
            <label>
                <input asp-for="RememberMe" /> @Html.DisplayNameFor(m => m.RememberMe)
            </label>
        </div>
        <button class="w-100 btn btn-lg btn-primary" type="submit">Giriş Yap</button>

        <div class="mt-3">
            <span class="text-muted">Hesabın yok mu?</span>
            <a asp-area="" asp-controller="Account" asp-action="Register" class="link-primary">Kayıt Ol</a>
        </div>
    </form>

    <p class="mt-4 mb-3 text-muted">&copy; 2025 - Ödev Dağıtım Portalı</p>
</main>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>