@using Homework_portal.Models.ViewModels
@model ProfileVM
@{
    ViewData["Title"] = "Hesabým";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
<div class="row mt-3">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <h5 class="mb-0">Hesap Bilgileri</h5>
            </div>
            <div class="card-body">
                <form asp-action="Profile" method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Ad" class="form-label"></label>
                            <input asp-for="Ad" class="form-control" />
                            <span asp-validation-for="Ad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Soyad" class="form-label"></label>
                            <input asp-for="Soyad" class="form-control" />
                            <span asp-validation-for="Soyad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="OgrenciNo" class="form-label"></label>
                            <input asp-for="OgrenciNo" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Sinif" class="form-label"></label>
                            <select asp-for="Sinif" class="form-select">
                                <option value="">-- Seçiniz --</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </select>
                            <span asp-validation-for="Sinif" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Sube" class="form-label"></label>
                            <select asp-for="Sube" class="form-select">
                                <option value="">-- Seçiniz --</option>
                                @for (char c = 'A'; c <= 'Z'; c++)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                            <span asp-validation-for="Sube" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mt-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                        <a asp-controller="Ogrenci" asp-action="Derslerim" class="btn btn-outline-secondary">Geri</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}