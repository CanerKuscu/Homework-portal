// ---- YENİ DOSYA OLUŞTUR ----
// Dosya Yolu: Homework-portal/Views/Ogrenci/TeslimEt.cshtml

@model Homework_portal.Models.ViewModels.TeslimVM

@{
    ViewData["Title"] = "Ödev Teslim Et";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Ödev Teslim Formu</h4>
                </div>
                <div class="card-body">

                    <h5>@Model.Odev.Baslik</h5>
                    <p class="text-muted">Son Teslim: @Model.Odev.TeslimTarihi.ToString("dd MMMM yyyy, HH:mm")</p>
                    <hr />
                    <p>@Model.Odev.Aciklama</p>
                    <hr />

                    <form method="post" asp-action="TeslimEt" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input asp-for="Teslim.OdevId" type="hidden" />


                        <div class="mb-3">
                            <label asp-for="Dosya" class="form-label"></label>
                            <input asp-for="Dosya" class="form-control" type="file" required />
                            <span asp-validation-for="Dosya" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Ödevi Teslim Et
                            </button>

                            <a asp-action="Odevler" asp-route-id="@Model.Odev.DersId" class="btn btn-secondary">
                                <i class="bi bi-x-lg"></i> İptal
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        // Formdaki validasyon (doğrulama) hatalarını (örn: "Lütfen bir dosya seçin.")
        // göstermek için bu partial view'ı ekliyoruz.
        <partial name="_ValidationScriptsPartial" />
    }
}