@model Homework_portal.Models.ViewModels.AssignmentsVM

@{
    ViewData["Title"] = Model.Course.Name + " - Ödevler";
}

<div class="container mt-4">

    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2 class="text-primary mb-0">@Model.Course.Name</h2>
            <small class="text-muted">Bu dersin ödevleri</small>
        </div>
        <div class="col-auto">
            <a asp-controller="Student" asp-action="MyCourses" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Derslere Dön
            </a>
        </div>
    </div>

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    @if (!Model.Assignments.Any())
    {
        <div class="alert alert-info" role="alert">
            Henüz hiçbir ödev yok.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>Baþlýk</th>
                        <th>Son Tarih</th>
                        <th>Durum</th>
                        <th>Not</th>
                        <th style="width: 300px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Assignments)
                    {
                        var submission = Model.StudentSubmissions.FirstOrDefault(t => t.AssignmentId == a.Id);
                        bool overdue = a.DueDate.ToUniversalTime() < DateTime.UtcNow;
                        <tr>
                            <td>
                                <div class="fw-semibold">@a.Title</div>
                            </td>
                            <td>
                                @a.DueDate.ToString("dd MMM yyyy, HH:mm")
                                @if (overdue && submission == null)
                                {
                                    <span class="badge bg-danger ms-2">Süresi Doldu</span>
                                }
                            </td>
                            @if (submission != null)
                            {
                                <td><span class="badge bg-success">Teslim Edildi</span></td>
                                <td>@(submission.Grade.HasValue ? submission.Grade.ToString() : "Beklemede")</td>
                                <td class="text-end">
                                    @* Uploaded files are hidden here per request *@
                                    <span class="text-muted">—</span>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-warning text-dark">Teslim Edilmedi</span>
                                </td>
                                <td>-</td>
                                <td>
                                    @if (overdue)
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled title="Teslim süresi dolmuþ; gönderim kapalý">Teslim Süresi Doldu</button>
                                    }
                                    else
                                    {
                                        <a asp-controller="Student" asp-action="Submit" asp-route-id="@a.Id" class="btn btn-primary btn-sm">Detay</a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
