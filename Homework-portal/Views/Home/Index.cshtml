@{
    ViewData["Title"] = "Anasayfa";
}

<div class="container py-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-0">Hoş Geldiniz</h2>
            <small class="text-muted">Ödev Dağıtım Portalı</small>
        </div>
        <div class="col-auto">
            <a asp-controller="Student" asp-action="MyCourses" class="btn btn-primary">
                <i class="bi bi-book"></i> Derslerime Git
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-book-open fa-lg text-primary me-2"></i>
                        <h5 class="card-title mb-0">Derslerim</h5>
                    </div>
                    <p class="text-muted mb-3">Kayıtlı olduğunuz dersleri görüntüleyin ve ödevlerinizi takip edin.</p>
                    <a asp-controller="Student" asp-action="MyCourses" class="btn btn-outline-primary btn-sm">Görüntüle</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-user-cog fa-lg text-success me-2"></i>
                        <h5 class="card-title mb-0">Profil</h5>
                    </div>
                    <p class="text-muted mb-3">Ad, soyad, e-posta, sınıf, şube ve öğrenci numarası bilgilerinizi güncelleyin.</p>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-success btn-sm">Düzenle</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <i class="fas fa-info-circle fa-lg text-secondary me-2"></i>
                        <h5 class="card-title mb-0">Bilgilendirme</h5>
                    </div>
                    <p class="text-muted mb-0">Yeni bir ödev oluşturulduğunda veya güncellendiğinde üstte bir bildirim göreceksiniz.</p>
                </div>
            </div>
        </div>
    </div>
</div>
